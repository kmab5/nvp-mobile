{
  "expo": {
    "name": "NVP",
    "slug": "nvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nvp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E11",
    "primaryColor": "#B24BFF",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0E11"
    },
    "android": {
      "package": "dev.kmab.nvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E11",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nvp-kmab.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-splash-screen",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://nvp-kmab.vercel.app"
    }
  }
}
